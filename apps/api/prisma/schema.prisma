generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          Role           @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at")
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  trackedAccounts TrackedAccount[] //yeni

  @@map("users")
}

model TrackedAccount {
  id             String          @id @default(uuid())
  userId         String         @map("user_id") // yeni
  user           User           @relation(fields: [userId], references: [id]) //yeni
  igUsername     String          @unique @map("ig_username")
  sourceType     SourceType      @map("source_type")
  accessTokenEnc String?         @map("access_token_enc")
  scheduleCron   String?         @map("schedule_cron")
  status         String          @default("active")
  igAccountId    String?         @map("ig_account_id")
  accountMetrics AccountMetric[]
  collectionJobs CollectionJob[]
  posts          Post[]

  @@map("tracked_accounts")
}

model Post {
  id          String         @id @default(uuid())
  accountId   String         @map("account_id")
  igMediaId   String         @unique @map("ig_media_id")
  type        String
  caption     String?
  postedAt    DateTime?      @map("posted_at")
  permalink   String?
  comments    Comment[]
  postMetrics PostMetric?
  account     TrackedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, postedAt])
  @@map("posts")
}

model PostMetric {
  id             String   @id @default(uuid())
  postId         String   @unique @map("post_id")
  capturedAt     DateTime @default(now()) @map("captured_at")
  likes          Int      @default(0)
  commentsCount  Int      @default(0) @map("comments_count")
  views          Int      @default(0)
  reach          Int      @default(0)
  engagementRate Float    @default(0.0) @map("engagement_rate")
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([capturedAt])
  @@map("post_metrics")
}

model AccountMetric {
  id         String         @id @default(uuid())
  accountId  String         @map("account_id")
  capturedAt DateTime       @default(now()) @map("captured_at")
  followers  Int            @default(0)
  following  Int            @default(0)
  mediaCount Int            @default(0) @map("media_count")
  account    TrackedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([capturedAt])
  @@map("account_metrics")
}

model Comment {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  authorHash  String   @map("author_hash")
  text        String
  commentedAt DateTime @map("commented_at")
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}

model AnalysisResult {
  id           String   @id @default(uuid())
  subjectType  String   @map("subject_type")
  subjectId    String   @map("subject_id")
  kind         String
  payload      Json
  modelVersion String   @map("model_version")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@index([subjectId, kind, createdAt])
  @@map("analysis_results")
}

model CollectionJob {
  id             String         @id @default(uuid())
  accountId      String         @map("account_id")
  startedAt      DateTime       @default(now()) @map("started_at")
  finishedAt     DateTime?      @map("finished_at")
  status         String
  itemsCollected Int            @default(0) @map("items_collected")
  error          String?
  account        TrackedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("collection_jobs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  resource  String
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  family    String
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([family])
  @@index([userId])
  @@map("refresh_tokens")
}

enum Role {
  USER
  ADMIN
}

enum SourceType {
  API
  SCRAPE
  MOCK
  AI
}
