  "info": {
    "title": "Instascope API",
    "description": "Instascope backend servis dokümantasyonu",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "accounts",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Kullanıcının adı (isteğe bağlı)",
            "example": "Nazgül Aksoy"
          },
          "email": {
            "type": "string",
            "description": "Kullanıcının e-posta adresi",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "Kullanıcının şifresi",
            "example": "S3cur3P@ssw0rd"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Kullanıcının e-posta adresi",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "description": "Kullanıcının şifresi",
            "example": "S3cur3P@ssw0rd"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Yenileme tokenı",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateAccountDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Eklenecek Instagram kullanıcı adı",
            "example": "atolye.studio"
          },
          "sourceType": {
            "type": "string",
            "description": "Kaynak türü",
            "example": "API",
            "enum": [
              "API",
              "SCRAPE",
              "MOCK",
              "AI"
            ]
          },
          "frequency": {
            "type": "string",
            "description": "Toplama sıklığı",
            "example": "daily"
          },
          "accessTokenEnc": {
            "type": "string",
            "description": "İsteğe bağlı erişim anahtarı"
          }
        },
        "required": [
          "username",
          "sourceType"
        ]
      },
      "AccountResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Hesap IDsi",
            "example": "b7351c3c-c464..."
          },
          "igUsername": {
            "type": "string",
            "description": "Instagram kullanıcı adı",
            "example": "atolye.studio"
          },
          "igAccountId": {
            "type": "string",
            "description": "Instagram Hesap IDsi",
            "example": "17841444785369518"
          },
          "sourceType": {
            "type": "string",
            "description": "Kaynak türü",
            "enum": [
              "API",
              "SCRAPE",
              "MOCK",
              "AI"
            ]
          },
          "scheduleCron": {
            "type": "string",
            "description": "Zamanlama kuralı",
            "example": "0 0 * * *"
          },
          "status": {
            "type": "string",
            "description": "Hesap durumu",
            "example": "active"
          }
        },
        "required": [
          "id",
          "igUsername",
          "sourceType",
          "status"
        ]
      }
    }
  }
}