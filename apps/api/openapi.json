    "/accounts/{id}/posts": {
      "get": {
        "operationId": "AccountsController_getAccountPosts",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Sayfalama için cursor (son gönderinin IDsi)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Sayfa başına kayıt sayısı",
            "schema": {
              "default": 10,
              "type": "number"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Sıralama alanı",
            "schema": {
              "default": "date",
              "enum": [
                "date",
                "engagement"
              ],
              "type": "string"
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "description": "Sıralama yönü",
            "schema": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "name": "contentType",
            "required": false,
            "in": "query",
            "description": "İçerik tipi filtresi (örn. IMAGE, VIDEO, CAROUSEL)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "accounts"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
